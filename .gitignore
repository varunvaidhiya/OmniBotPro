build/
# OhhO Build (the website robot designer) lives in directories literally named
# `build/`. Re-include their source so the broad colcon `build/` ignore above
# doesn't swallow it. (Negating the directory itself — not just files inside —
# is what makes git re-scan it.)
!website/app/build/
!website/components/build/
!website/lib/build/
install/
log/
*.log
__pycache__/
*.pyc
.vscode/
.idea/
.DS_Store
py_install_extracted/
ROS-robot-expansion-board/
ROSMASTERX3_Driver/
robot_ws/yahboom_repo/
install/
log/
*.log
__pycache__/
*.pyc
.vscode/
.idea/
.DS_Store
yahboom_debug.log
.coverage
coverage.xml
htmlcov/
*.egg-info/


# Secrets and deployment config
.env
deployment.env
!deployment.env.example
!*.env.example

# Build artifacts
dist/
*.onnx
*.pt
*.pth

# Python
.eggs/
*.so
*.pyd
site/
.venv/
venv/
