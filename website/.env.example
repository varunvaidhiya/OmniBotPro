# OhhO website — client (NEXT_PUBLIC_*) env vars.
# Copy to .env.local for local dev, and set the same in Vercel → Project →
# Settings → Environment Variables. With these unset the site still builds and
# runs; auth UI shows a "not configured" notice until credentials are added.

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Canonical site origin (used for OAuth / checkout redirects when window is absent).
# Optional — defaults to window.location.origin in the browser.
NEXT_PUBLIC_SITE_URL=https://ohho-robotics.com

# Social login on /login. Email magic-link always works with just Supabase.
# Google requires a (free) Google Cloud OAuth credential configured in Supabase.
# Set to "google" to show the Google button; leave empty for email-only.
NEXT_PUBLIC_OAUTH_PROVIDERS=google

# ── Firebase Analytics (GA4) ──────────────────────────────────────────────────
# From Firebase console → Project settings → General → Your apps → Web app →
# "SDK setup and configuration" → Config. Full walkthrough in
# FIREBASE_ANALYTICS_SETUP.md. These values are public by design (they ship in
# the client bundle) — they identify the project, they don't authorise anything.
# With them unset the site builds and runs exactly as before and the Firebase
# SDK is never downloaded.
#
# Required — analytics stays off unless all four are set:
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
# The GA4 data stream this site reports into. Analytics does nothing without it.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
#
# Optional — only needed by other Firebase products, unused by Analytics:
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
#
# Set to "true" to route events to GA4 DebugView for verification. Leave unset
# in production — debug events are excluded from normal reports.
# NEXT_PUBLIC_FIREBASE_DEBUG=true

# Kill switch for ALL analytics providers (Firebase, Plausible, PostHog).
# NEXT_PUBLIC_ANALYTICS=off

# ── Plausible (optional, runs alongside Firebase) ─────────────────────────────
# Set the domain to load the Plausible snippet; NEXT_PUBLIC_FIREBASE_* is
# independent of this. Override the src to point at a self-hosted instance.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ohho-robotics.com
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# ── NOT used by the website build (set these as Supabase Edge Function secrets) ──
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_BUILDER=price_...
# STRIPE_PRICE_FLEET=price_...

# ── OhhO Build — natural-language design generation (server-side only) ──
# Get a key at https://platform.kimi.ai/console/api-keys. Without it the
# "Describe your robot" box shows a clear error; the rest of Build still works.
MOONSHOT_API_KEY=sk-...
# Optional: override the Kimi/Moonshot model. Defaults to moonshot-v1-128k.
# Alternatives: kimi-k2.6, kimi-k2.5, moonshot-v1-32k, moonshot-v1-auto.
# MOONSHOT_MODEL=moonshot-v1-128k

# ── MCP server — API key for external AI agents (server-side only) ──
# Set to a strong random string to require auth on /api/mcp.
# When unset, the MCP endpoint is open (development mode).
# Clients send this via X-API-Key or Authorization: Bearer header.
# MCP_API_KEY=your-secret-key-here

# ── In-console AI assistant — OpenRouter (server-side only) ──
# Powers the "Ask OhhO" assistant shown on every console. OpenRouter
# (https://openrouter.ai/keys) is an OpenAI-compatible gateway to every major
# model behind one key, so users can pick Claude / GPT / Gemini / Llama / etc.
# Without this key the assistant renders but shows a "not configured" notice.
OPENROUTER_API_KEY=sk-or-...
# Optional: override the selectable model catalog (comma-separated "id|Label").
# Defaults to the curated list in lib/assistant/models.ts.
# OPENROUTER_MODELS=anthropic/claude-sonnet-4|Claude Sonnet 4,openai/gpt-4o|GPT-4o
# Optional: which model is selected first. Defaults to the first in the list.
# OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4
# Optional: attribution headers shown in your OpenRouter dashboard.
# OPENROUTER_SITE_URL=https://ohho-robotics.com
# OPENROUTER_APP_NAME=OhhO Console Assistant
