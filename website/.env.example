# OhhO website — client (NEXT_PUBLIC_*) env vars.
# Copy to .env.local for local dev, and set the same in Vercel → Project →
# Settings → Environment Variables. With these unset the site still builds and
# runs; auth UI shows a "not configured" notice and console gating is bypassed.

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Canonical site origin (used for OAuth / checkout redirects when window is absent).
# Optional — defaults to window.location.origin in the browser.
NEXT_PUBLIC_SITE_URL=https://ohho-robotics.com

# Social login providers to show on /login. Email magic-link always works with
# just Supabase (no developer account needed). Google/Apple require external
# developer accounts, so they stay hidden until listed here. Leave empty for
# email-only; set to e.g. "google,apple" once those providers are configured.
NEXT_PUBLIC_OAUTH_PROVIDERS=

# ── NOT used by the website build (set these as Supabase Edge Function secrets) ──
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_BUILDER=price_...
# STRIPE_PRICE_FLEET=price_...
