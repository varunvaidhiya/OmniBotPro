<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omnibot_metrics</name>
  <version>0.1.0</version>
  <description>
    Prometheus metrics bridge for OmniBot. Subscribes to ROS 2 topics
    (/diagnostics, /odom, /mission/*, /arm/joint_states, /emergency_stop,
    /control_mode/active, /ai/command) and exposes them as Prometheus metrics
    via an HTTP endpoint for scraping.
  </description>
  <maintainer email="varun.vaidhiya@gmail.com">Varun Vaidhiya</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>

  <!-- prometheus_client is installed via pip, not rosdep, to avoid rosdep key issues.
       Install with: pip install prometheus-client>=0.20 -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
