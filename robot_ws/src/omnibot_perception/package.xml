<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omnibot_perception</name>
  <version>0.1.0</version>
  <description>
    Unified perception pipeline for OmniBot: object detection, tracking, instance
    segmentation, and depth-fused distance estimation.  Bridges raw camera streams
    to SmolVLA / RL arm / mission-planner via standard ROS 2 topics.
  </description>
  <maintainer email="varun.vaidhiya@gmail.com">OmniBot Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Runtime Python deps (installed via pip, not rosdep) -->
  <!-- ultralytics>=8.2  opencv-python  numpy  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
