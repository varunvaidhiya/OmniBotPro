<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RobotControl" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hud_accent</item>
        <item name="colorPrimaryVariant">@color/hud_bg</item>
        <item name="colorOnPrimary">@color/hud_bg</item>
        <item name="colorSecondary">@color/hud_accent2</item>
        <item name="colorSecondaryVariant">@color/hud_bg</item>
        <item name="colorOnSecondary">@color/hud_bg</item>
        <item name="colorSurface">@color/hud_bg</item>
        <item name="colorOnSurface">@color/hud_text</item>
        <item name="android:colorBackground">@color/hud_bg</item>
        <item name="colorOnBackground">@color/hud_text</item>
        <item name="android:statusBarColor">@color/hud_bg</item>
        <item name="android:navigationBarColor">@color/hud_bg</item>
        <item name="android:windowBackground">@color/hud_bg</item>
        <item name="android:forceDarkAllowed" tools:targetApi="Q">false</item>
        <!-- TextInputLayout accent -->
        <item name="colorControlActivated">@color/hud_accent</item>
        <item name="colorControlNormal">@color/hud_card_border</item>
    </style>

    <style name="Theme.RobotControl.Fullscreen" parent="Theme.RobotControl">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- HUD button toggle group style: no corner radius, cyan active -->
    <style name="Widget.HUD.ButtonToggle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">0dp</item>
        <item name="strokeColor">@color/hud_card_border</item>
        <item name="android:textColor">@color/hud_inactive</item>
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>
</resources>
