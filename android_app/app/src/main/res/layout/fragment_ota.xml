<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Page header ─────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OTA UPDATE SYSTEM"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/hud_accent"
            android:fontFamily="monospace"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Over-the-air firmware and model update control."
            android:textSize="8sp"
            android:textColor="@color/hud_muted"
            android:fontFamily="monospace"
            android:layout_marginTop="3dp" />

        <!-- ── ROBOT UPDATE card ────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/hud_card_bg"
            android:padding="12dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROBOT UPDATE"
                android:textSize="9sp"
                android:textColor="@color/hud_muted"
                android:fontFamily="monospace"
                android:letterSpacing="0.06" />

            <!-- Status dot + state -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <View
                    android:id="@+id/ota_ws_status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/shape_circle_red" />

                <TextView
                    android:id="@+id/text_ws_state"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:text="STATE: OFFLINE"
                    android:textColor="@color/hud_text"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Version info -->
            <TextView
                android:id="@+id/text_ws_current_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT: —"
                android:textColor="@color/hud_muted"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/text_ws_pending_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING: —"
                android:textColor="@color/hud_warn"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

            <!-- Download progress -->
            <ProgressBar
                android:id="@+id/ota_ws_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:progressTint="@color/hud_accent"
                android:progressBackgroundTint="@color/hud_bar_track"
                android:max="100"
                android:progress="0"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_ws_progress_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/hud_accent"
                android:textSize="8sp"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

            <!-- Action buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_check_update"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:text="CHECK FOR UPDATE"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textColor="@color/hud_accent"
                android:backgroundTint="#0A00E5FF"
                app:strokeColor="@color/hud_accent"
                app:strokeWidth="1dp"
                app:cornerRadius="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_apply_workspace"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:text="APPLY ROBOT UPDATE"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textColor="@color/hud_ok"
                android:backgroundTint="#0A00FF7F"
                app:strokeColor="@color/hud_ok"
                app:strokeWidth="1dp"
                app:cornerRadius="2dp"
                android:enabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rollback"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:text="ROLLBACK"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textColor="@color/hud_warn"
                android:backgroundTint="#14FFD700"
                app:strokeColor="@color/hud_warn"
                app:strokeWidth="1dp"
                app:cornerRadius="2dp"
                android:enabled="false" />
        </LinearLayout>

        <!-- ── MODEL UPDATE card ────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/hud_card_bg"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODEL UPDATE"
                android:textSize="9sp"
                android:textColor="@color/hud_muted"
                android:fontFamily="monospace"
                android:letterSpacing="0.06" />

            <!-- Version info -->
            <TextView
                android:id="@+id/text_model_current_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT: —"
                android:textColor="@color/hud_muted"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/text_model_pending_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING: —"
                android:textColor="@color/hud_warn"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

            <!-- Model download progress -->
            <ProgressBar
                android:id="@+id/ota_model_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:progressTint="@color/hud_accent"
                android:progressBackgroundTint="@color/hud_bar_track"
                android:max="100"
                android:progress="0"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_model_progress_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="@color/hud_accent"
                android:textSize="8sp"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_apply_models"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:text="APPLY MODEL UPDATE"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textColor="@color/hud_ok"
                android:backgroundTint="#0A00FF7F"
                app:strokeColor="@color/hud_ok"
                app:strokeWidth="1dp"
                app:cornerRadius="2dp"
                android:enabled="false" />
        </LinearLayout>

        <!-- ── Action result ────────────────────────────────────────── -->
        <TextView
            android:id="@+id/text_action_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="@color/hud_text"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:background="@color/hud_card_bg"
            android:padding="8dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
