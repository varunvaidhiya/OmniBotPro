<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:background="@color/hud_card_bg"
    android:layout_marginBottom="3dp"
    android:gravity="center_vertical">

    <View
        android:id="@+id/accent_bar"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@color/hud_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp">

        <TextView
            android:id="@+id/text_run_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="run-name"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/hud_text"
            android:fontFamily="monospace"
            android:ellipsize="end"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_run_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025-01-01"
                android:textSize="7sp"
                android:textColor="@color/hud_inactive"
                android:fontFamily="monospace"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/text_run_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="7sp"
                android:textColor="@color/hud_muted"
                android:fontFamily="monospace"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/text_run_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FINISHED"
        android:textSize="7sp"
        android:textStyle="bold"
        android:textColor="@color/hud_accent"
        android:fontFamily="monospace"
        android:paddingEnd="10dp" />

</LinearLayout>
