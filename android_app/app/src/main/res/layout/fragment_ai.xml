<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/hud_bg">

    <!-- ── Top status bar ──────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@color/hud_bg">

        <!-- Status dot + AI state label -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="7dp">

            <!-- Pulsing halo (animated in fragment) -->
            <View
                android:id="@+id/ai_dot_halo"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/shape_circle_red"
                android:layout_gravity="center"
                android:alpha="0" />

            <View
                android:id="@+id/ai_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/shape_circle_red"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/text_ai_state_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OMNIBOT · IDLE"
            android:textColor="@color/hud_muted"
            android:textSize="9.5sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05" />

        <!-- VISUAL / CHAT toggle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/hud_card_bg">

            <TextView
                android:id="@+id/btn_view_visual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⊙ VISUAL"
                android:textColor="@color/hud_bg"
                android:textSize="8sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:background="@color/hud_accent"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_view_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬 CHAT"
                android:textColor="@color/hud_inactive"
                android:textSize="8sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom border -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/hud_card_border" android:alpha="0.5"/>

    <!-- ══ VISUAL mode ═════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_visual_mode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="4dp">

        <!-- JARVIS canvas 262×262dp -->
        <com.varunvaidhiya.robotcontrol.ui.views.JarvisView
            android:id="@+id/jarvis_view"
            android:layout_width="262dp"
            android:layout_height="262dp" />

        <!-- Speech text -->
        <TextView
            android:id="@+id/text_speech"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="OMNIBOT ONLINE.\nAWAITING COMMAND."
            android:textColor="@color/hud_muted"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.07"
            android:lineSpacingMultiplier="1.8"
            android:paddingStart="18dp"
            android:paddingEnd="18dp" />

        <!-- Quick action chips -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/chip_navigate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAVIGATE HOME"
                android:textColor="@color/hud_muted"
                android:textSize="7.5sp"
                android:fontFamily="monospace"
                android:background="@color/hud_card_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_explore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPLORE AREA"
                android:textColor="@color/hud_muted"
                android:textSize="7.5sp"
                android:fontFamily="monospace"
                android:background="@color/hud_card_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_pick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PICK UP OBJECT"
                android:textColor="@color/hud_muted"
                android:textSize="7.5sp"
                android:fontFamily="monospace"
                android:background="@color/hud_card_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STOP"
                android:textColor="@color/hud_err"
                android:textSize="7.5sp"
                android:fontFamily="monospace"
                android:background="@color/hud_card_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══ CHAT mode ═══════════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <!-- Recording row (hidden in HUD mode — kept for binding compat) -->
    <LinearLayout
        android:id="@+id/card_recording"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_recording_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dataset recording: OFF"
            android:textColor="@color/hud_text"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_recording"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- ── Input row (always visible) ──────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="#B3000C16">

        <!-- Top border -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/hud_card_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CMD>"
                android:textColor="@color/hud_muted"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/edit_command"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:textColor="@color/hud_accent"
                android:textColorHint="@color/hud_muted"
                android:hint="Type a command…"
                android:textSize="9.5sp"
                android:fontFamily="monospace"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:singleLine="true"
                android:letterSpacing="0.03" />
        </LinearLayout>

        <!-- Send button -->
        <TextView
            android:id="@+id/btn_send"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="@color/hud_accent"
            android:textSize="12sp"
            android:background="@color/hud_card_bg"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
